# Settings for docker-compose.yml. Copy this file to .env and fill it in. .env is never committed.
#   cp .env.example .env

# The key that lets you create tenants (POST /admin/tenants). Long and random, kept to yourself.
# Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# The secret the panel encrypts its session cookie with: at least 32 characters, and never shared.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everybody out.
SESSION_SECRET=

# The database password. The database is only reachable from the other containers, but still set your own
# if the machine is shared. Leave it out to use a development default.
# POSTGRES_PASSWORD=

# Where webhooks may be sent. The defaults are the safe ones for a real deployment: https only, and no
# addresses on a private network (so the service cannot be used to reach your internal systems).
# To try it against the demo receiver (docker compose --profile demo up -d), which is on a private network and
# speaks plain http, allow both. Do not do this on a server that is reachable from outside.
# ALLOW_PRIVATE_NETWORKS=true
# REQUIRE_HTTPS=false

# How the worker learns that a delivery is due. Postgres (the default): it asks the database. RabbitMq: a relay
# announces due deliveries to RabbitMQ and the worker acts on the messages. The database remains the source of truth
# either way, and you can switch back at any time without migrating anything. Start the broker with
# docker compose --profile rabbitmq up -d. See docs/decisions/0010-rabbitmq-transport.md.
# DELIVERY_TRANSPORT=RabbitMq

# The password of the RabbitMQ user "webhooks". Required with the rabbitmq profile; there is no default.
# Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# RABBITMQ_PASSWORD=

# How much one worker takes on at a time: deliveries claimed per round and requests sent at once.
# The defaults are the cautious ones; docs/performance.md shows what raising them does on one machine.
# DELIVERY_BATCH_SIZE=20
# DELIVERY_MAX_PARALLELISM=8
