# Copy this file to .env.local and fill it in. .env.local is never committed.
#
# Both values are read only on the server. They must never get a NEXT_PUBLIC_ prefix: that would put
# them in the JavaScript that is sent to the browser.

# Where the webhook API listens (the server calls it, the browser never does).
API_BASE_URL=http://localhost:5005

# The secret the session cookie is encrypted with: at least 32 characters, and there is no default.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everybody out. Never reuse a value you have shared anywhere.
SESSION_SECRET=
